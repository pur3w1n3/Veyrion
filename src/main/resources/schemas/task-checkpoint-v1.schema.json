{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veyrion.local/schemas/task-checkpoint-v1.schema.json",
  "title": "TaskCheckpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "checkpointId", "traceSequence", "createdAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": { "$ref": "#/$defs/scope" },
    "checkpointId": { "$ref": "#/$defs/id" },
    "traceSequence": { "type": "integer", "minimum": -1 },
    "traceHeadDigest": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "artifactDigest", "scanId", "taskId"],
      "properties": {
        "projectId": { "$ref": "#/$defs/id" }, "artifactDigest": { "$ref": "#/$defs/sha256" },
        "scanId": { "$ref": "#/$defs/id" }, "taskId": { "$ref": "#/$defs/id" }
      }
    }
  }
}
