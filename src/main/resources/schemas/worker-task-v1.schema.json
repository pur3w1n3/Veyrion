{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veyrion.local/schemas/worker-task-v1.schema.json",
  "title": "WorkerTaskSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "artifactDigest", "scanId", "taskId", "targetEntryId", "authorized", "fixtureOnly", "resourceBudget", "networkPolicy", "requiredCapability"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "$ref": "#/$defs/id" },
    "artifactDigest": { "$ref": "#/$defs/sha256" },
    "scanId": { "$ref": "#/$defs/id" },
    "taskId": { "$ref": "#/$defs/id" },
    "targetEntryId": { "$ref": "#/$defs/id" },
    "authorized": { "type": "boolean" },
    "fixtureOnly": { "type": "boolean" },
    "requiredCapability": { "enum": ["STATIC_ONLY", "FIXTURE_RUNC", "HARDENED_GVISOR", "HARDENED_KATA"] },
    "fixtureId": { "$ref": "#/$defs/id" },
    "imageUri": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^[a-z0-9.-]+(?:/[A-Za-z0-9._-]+)+@sha256:[0-9a-f]{64}$"
    },
    "mainClass": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$.]{0,254}$"
    },
    "fixtureDigest": { "$ref": "#/$defs/sha256" },
    "resourceBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxWallClockSeconds", "maxCpuMillis", "maxMemoryBytes", "maxDiskBytes", "maxTraceBytes"],
      "properties": {
        "maxWallClockSeconds": { "type": "integer", "minimum": 1 },
        "maxCpuMillis": { "type": "integer", "minimum": 1 },
        "maxMemoryBytes": { "type": "integer", "minimum": 1 },
        "maxDiskBytes": { "type": "integer", "minimum": 1 },
        "maxTraceBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowlist"],
      "properties": {
        "mode": { "enum": ["DENY", "ALLOWLIST"] },
        "allowlist": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^\\S+$" } }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          { "required": ["fixtureId"] },
          { "required": ["imageUri"] },
          { "required": ["mainClass"] },
          { "required": ["fixtureDigest"] }
        ]
      },
      "then": {
        "required": ["fixtureId", "imageUri", "mainClass", "fixtureDigest"],
        "properties": {
          "fixtureOnly": { "const": true },
          "requiredCapability": { "const": "FIXTURE_RUNC" }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
