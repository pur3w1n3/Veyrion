# Copy to repo root as `.env` (Compose reads it) or pass via `--env-file`.
# Do not commit real secrets.

# Shared mutation token for Control Plane write APIs and the GUI bundle.
# Changing this requires rebuilding the gui service so VITE_API_TOKEN matches.
VEYRION_TOKEN=local-demo

# Optional host bind-mount for authorized artifacts (compose override example):
# VEYRION_ARTIFACTS_HOST=./samples
